{
  "name": "@marcandre/video-qr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-ffmpeg.mjs",
    "postinstall": "npm run assets",
    "dev": "npm run assets && vite --host 127.0.0.1",
    "build": "npm run assets && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "native:sync": "npm run build && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
