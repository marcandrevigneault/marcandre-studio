---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  titleEn?: string;
  descriptionEn?: string;
  /** Hide the global nav (e.g. immersive gallery pages render their own). */
  bareNav?: boolean;
  /** Hide the global footer (e.g. the admin, which is its own world). */
  bareFooter?: boolean;
}

const { title, titleEn = title, description = 'Photographie, art, projets et science par Marc-André Vigneault.', descriptionEn = 'Photography, art, projects, and science by Marc-André Vigneault.', bareNav = false, bareFooter = false } = Astro.props;
const siteName = 'Marc-André Vigneault';
const fullTitleEn = titleEn === siteName ? titleEn : `${titleEn} — ${siteName}`;
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
// Astro.site is undefined when this layout is rendered via experimental_AstroContainer
// (e.g. the admin live preview at /api/preview) — the installed astro version never
// honors a passed astroConfig.site there. Guard so preview rendering doesn't 500;
// canonical/og:url are simply omitted when there's no site to build them from.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title data-i18n-fr={fullTitle} data-i18n-en={fullTitleEn}>{fullTitle}</title>
    <meta name="description" content={description} data-i18n-fr-content={description} data-i18n-en-content={descriptionEn} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} data-i18n-fr-content={fullTitle} data-i18n-en-content={fullTitleEn} />
    <meta property="og:description" content={description} data-i18n-fr-content={description} data-i18n-en-content={descriptionEn} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Swap the .no-js class as early as possible so reveal styles can apply. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    {!bareNav && <Nav />}
    <main id="main">
      <slot />
    </main>
    {!bareFooter && <Footer />}
    <script src="../scripts/language.ts"></script>
    <script src="../scripts/motion.js"></script>
    <script src="../scripts/visits.ts"></script>
  </body>
</html>
