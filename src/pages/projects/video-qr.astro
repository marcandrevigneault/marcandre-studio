---
import EditableCopy from '../../components/EditableCopy.astro';
import QRThumb from '../../components/QRThumb.astro';
import Text from '../../components/Text.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Vidéo QR" titleEn="Video QR" description="Une minuscule vidéo, avec son, contenue dans un code QR. Expériences avec La Bête lumineuse." descriptionEn="A tiny video, sound included, stored inside a QR code. Experiments with La Bête lumineuse.">
  <header class="intro-banner">
    <div class="wrap intro">
    <a class="back" href="/projects/"><Text fr="← Projets" en="← Projects" /></a>
    <EditableCopy slug="page-video-qr-intro" heading="h1" lead showLogin />
    <a class="button" href="/tools/video-qr/index.html"><Text fr="Ouvrir l’encodeur / décodeur ↗" en="Open the encoder / decoder ↗" /></a>
    <p class="platforms"><Text fr="Web · Versions Android et iPhone en développement" en="Web · Android &amp; iPhone projects in development" /></p>
    </div>
  </header>

  <section class="wrap examples" aria-labelledby="examples-title">
    <div class="section-heading"><p class="eyebrow"><Text fr="Les expériences" en="The experiments" /></p><h2 id="examples-title"><Text fr="La Bête lumineuse" en="La Bête lumineuse" /></h2><p><Text fr="Pierre Perrault, 1982" en="Pierre Perrault, 1982" /> · <a href="https://www.youtube.com/watch?v=7Co_VgBgI7g"><Text fr="Voir le film source ↗" en="Source film ↗" /></a></p></div>
    <div class="samples">
      <article class="sample">
        <div class="screen"><video controls playsinline preload="none" poster="/examples/video-qr/poster.png" aria-label="Aperçu de huit secondes du film compressé" data-i18n-fr-aria-label="Aperçu de huit secondes du film compressé" data-i18n-en-aria-label="Eight-second preview of the compressed film"><source src="/examples/video-qr/film-preview.mp4" type="video/mp4" /></video></div>
        <div class="sample-info">
          <EditableCopy slug="page-video-qr-sample-01" />
        </div>
      </article>
      <article class="sample">
        <div class="screen"><video controls playsinline preload="metadata" aria-label="Elle fait même pas d’ombre : extrait avec son" data-i18n-fr-aria-label="Elle fait même pas d’ombre : extrait avec son" data-i18n-en-aria-label="Elle fait même pas d’ombre: clip with sound"><source src="/examples/video-qr/elle-fait-meme-pas-dombre-vqr.mp4" type="video/mp4" /></video></div>
        <div class="sample-info">
          <EditableCopy slug="page-video-qr-sample-02" />
          <QRThumb id="sample-02-qr" src="/examples/video-qr/elle-fait-meme-pas-dombre-vqr.png" title="Elle fait même pas d’ombre" />
        </div>
      </article>
      <article class="sample">
        <div class="screen"><video controls playsinline preload="none" poster="/examples/video-qr/extrait-sans-son-03-poster.png" aria-label="Extrait de trois secondes sans son contenu dans le QR" data-i18n-fr-aria-label="Extrait de trois secondes sans son contenu dans le QR" data-i18n-en-aria-label="Three-second silent clip stored in the QR"><source src="/examples/video-qr/extrait-sans-son-03.mp4" type="video/mp4" /></video></div>
        <div class="sample-info">
          <EditableCopy slug="page-video-qr-sample-03" />
          <QRThumb id="sample-03-qr" src="/examples/video-qr/extrait-sans-son-03.png" title="QR · 03" />
        </div>
      </article>
    </div>
  </section>
  <section class="wrap generator" aria-labelledby="generator-title">
    <div id="generator-title"><EditableCopy slug="page-video-qr-generator" heading="h2" /></div>
    <iframe id="film-generator" src="/tools/video-qr/film.html" title="Créer un QR à partir du film" data-i18n-fr-title="Créer un QR à partir du film" data-i18n-en-title="Make a QR from the film" loading="lazy"></iframe>
  </section>
</BaseLayout>
<script>
  const frame = document.querySelector<HTMLIFrameElement>('#film-generator');
  window.addEventListener('message', event => {
    if (event.origin !== location.origin || event.source !== frame?.contentWindow || event.data?.type !== 'film-generator-height') return;
    const height = Number(event.data.height);
    if (frame && Number.isFinite(height) && height > 0) frame.style.height = `${Math.min(5000, Math.max(500, Math.ceil(height) + 4))}px`;
  });
</script>
<style>
  .intro-banner { --ink: #fff9ef; --muted: #e0d9ce; --paper: #181c18; --line: #ffffff40; color: var(--ink); background: linear-gradient(90deg, rgba(8, 13, 10, .42), rgba(8, 13, 10, .08)), url('/examples/video-qr/la-bete-lumineuse-3662-7.jpg') center 44% / cover no-repeat; }
  .intro-banner :global(.editor-login) { display: inline-block; padding: .65rem 1rem; color: var(--ink); background: #181c18d9; border: 1px solid #ffffff80; text-decoration: none; }
  .intro-banner :global([data-article-title]), .intro-banner :global(.editable-body), .intro-banner .platforms { text-shadow: 0 2px 6px #0009; }
  .intro-banner :global(.editor-form) { background: var(--paper); }
  .generator { padding-block: 1rem 4rem; }
  .generator h2 { max-width: 24ch; }
  #film-generator { display: block; width: 100%; height: 1100px; border: 1px solid var(--line); margin-top: 2rem; }

  .intro { padding-block: clamp(3rem, 9vw, 7rem) 3rem; }.back { display: inline-block; font-size: .8rem; margin-bottom: 2.5rem; color: var(--muted); }.lede { max-width: 49ch; color: var(--muted); font-size: 1.2rem; }.button { display: inline-block; padding: .85rem 1.3rem; background: var(--ink); color: var(--paper); }.button:hover { background: var(--accent); }.platforms { font-size: .75rem; margin-top: .8rem; color: var(--muted); }
  .examples { padding-bottom: 3rem; }
  .section-heading { padding-top: 2rem; border-top: 1px solid var(--line); }
  .section-heading > p:last-child { color: var(--muted); font-size: .8rem; }
  .section-heading a { text-decoration: underline; }
  .sample { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); align-items: center; gap: clamp(1rem, 3vw, 2.5rem); padding-block: 1.5rem; border-bottom: 1px solid var(--line); }
  .screen { aspect-ratio: 8 / 5; background: #161813; overflow: hidden; }
  .screen video { display: block; width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; }
  .sample-info { display: flex; align-items: center; justify-content: space-between; gap: clamp(.75rem, 2vw, 1.5rem); min-width: 0; }
  .sample-info > :global(.editable-copy) { flex: 1; min-width: 0; }
  .sample-copy h3 { font-size: clamp(1.15rem, 2vw, 1.6rem); }
  .sample-copy p { margin-bottom: .6rem; }
  .sample-copy .eyebrow { margin-top: 0; }
  .sample-copy p:last-child { margin-bottom: 0; }
  .caption { color: var(--muted); font-size: .8rem; max-width: 55ch; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media(max-width: 650px) { .sample { grid-template-columns: 1fr; } }
</style>
