---
import Text from '../../components/Text.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Photographie" titleEn="Photography" description="Les galeries photo de Marc-André Vigneault sont à venir." descriptionEn="Photo galleries by Marc-André Vigneault are coming soon.">
  <header class="intro wrap">
    <p class="eyebrow" data-reveal><Text fr="Photographie" en="Photography" /></p>
    <h1 data-reveal="1"><Text fr="À venir" en="Coming soon" /></h1>
    <p class="lede measure" data-reveal="2">
      <Text fr="Les galeries prennent forme. Revenez bientôt pour les découvrir." en="The galleries are taking shape. Come back soon to explore them." />
    </p>
  </header>
</BaseLayout>

<style>
  .intro { padding-block: clamp(3rem, 10vw, 6rem) clamp(2rem, 5vw, 3rem); }
  .lede { color: var(--muted); font-size: clamp(1.05rem, 1rem + 0.4vw, 1.3rem); }
</style>
