---
import { getCollection, render } from 'astro:content';
import Text from '../../components/Text.astro';
import { frenchText } from '../../lib/content-translations';
import GalleryLayout from '../../layouts/GalleryLayout.astro';

export async function getStaticPaths() {
  const galleries = await getCollection('galleries', (c) => import.meta.env.DEV || !c.data.draft);
  return galleries.map((gallery) => ({
    params: { slug: gallery.id },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
const { Content } = await render(gallery);
// Existing gallery bodies are a single introduction; keep arbitrary future Markdown intact.
const intro = gallery.body?.trim().match(/^<p class="intro">([\s\S]*?)<\/p>$/)?.[1]?.trim();
const translatedIntro = intro ? frenchText(intro) : undefined;
---

<GalleryLayout gallery={gallery}>
  {intro && translatedIntro !== intro ? <Text as="p" class="intro" fr={translatedIntro!} en={intro} /> : <Content />}
</GalleryLayout>
