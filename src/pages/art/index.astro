---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Art" description="Digital art and other visual explorations by Marc-André Vigneault.">
  <section class="wrap intro">
    <p class="eyebrow">Art</p>
    <h1>Another way of seeing.</h1>
    <p class="lede">Digital art, studies and experiments in image-making.</p>
    <div class="empty"><span>01 / A collection in the making</span><p>New work will find its home here.</p></div>
    <a href="/projects/video-qr/">Explore the Video QR experiment →</a>
  </section>
</BaseLayout>
<style>
  .intro { padding-block: clamp(3rem, 10vw, 7rem); }
  .lede { color: var(--muted); }
  .empty { border-block: 1px solid var(--line); padding-block: 3rem; margin-block: 3rem; }
  .empty span { font: .75rem var(--font-mono); color: var(--muted); }
  .empty p { font: 1.6rem var(--font-serif); margin: 1rem 0 0; }
  a { text-decoration: underline; }
</style>
