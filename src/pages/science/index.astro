---
import Text from '../../components/Text.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Science" description="Les textes et expériences scientifiques de Marc-André Vigneault sont à venir." descriptionEn="Scientific writing and experiments by Marc-André Vigneault are coming soon.">
  <header class="intro wrap">
    <p class="eyebrow"><Text fr="Science" en="Science" /></p>
    <h1><Text fr="À venir" en="Coming soon" /></h1>
    <p class="lede measure"><Text fr="Les textes et expériences prennent forme. Revenez bientôt pour les découvrir." en="The writing and experiments are taking shape. Come back soon to explore them." /></p>
  </header>
</BaseLayout>
<style>
  .intro { padding-block: clamp(3rem, 10vw, 6rem); }
  .lede { color: var(--muted); font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); }
</style>
