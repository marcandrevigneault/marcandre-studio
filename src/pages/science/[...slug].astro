---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (c) => import.meta.env.DEV || !c.data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const translations = import.meta.glob('../../content-translations/fr/*.mdx', { eager: true });
const { article } = Astro.props;
const FrenchContent = (translations[`../../content-translations/fr/${article.id}.mdx`] as { default: any } | undefined)?.default;
const { Content } = await render(article);
---

<ArticleLayout article={article}>
  {FrenchContent ? (<>
    <div data-language-content="fr" lang="fr"><FrenchContent /></div>
    <div data-language-content="en" lang="en"><Content /></div>
  </>) : <Content />}
</ArticleLayout>
