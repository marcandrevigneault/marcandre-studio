---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isValidSession } from '../../lib/auth';
if (isValidSession(Astro.request.headers.get('cookie'))) return Astro.redirect('/admin');
---
<BaseLayout title="Admin login" bareNav={true}>
  <div class="login-wrap">
    <div class="login-card">
      <div class="wordmark">Studio<span class="dot">.</span></div>
      <p class="login-sub">Marc-André's private workspace</p>
      <div class="rule"></div>
      <form id="login-form" novalidate>
        <div class="field">
          <label for="pw">Password</label>
          <input
            class="input pw"
            id="pw"
            name="password"
            type="password"
            autocomplete="current-password"
            autofocus
            required
          />
        </div>
        <button class="btn block" type="submit" id="signin">Sign in</button>
        <p class="login-error" id="err" role="alert" hidden></p>
        <p class="login-foot" id="loginfoot">Stays signed in for 30 days on this device.</p>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  .login-wrap {
    /* light (paper) tokens, scoped to this page only */
    --lw-surface: #ffffff;
    --lw-line: #e7e3da;
    --lw-accent: #9a6b4f;
    --lw-accent-ink: #ffffff;
    --lw-danger: #b3261e;

    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 40px 20px;
    background: radial-gradient(
      120% 90% at 50% -10%,
      color-mix(in oklab, var(--lw-accent) 9%, transparent),
      transparent 60%
    );
  }

  @media (prefers-color-scheme: dark) {
    .login-wrap {
      --lw-surface: #1e1b15;
      --lw-line: #322d24;
      --lw-accent: #c99a76;
      --lw-accent-ink: #16140f;
      --lw-danger: #e2867c;
    }
  }

  .login-card {
    width: 100%;
    max-width: 360px;
    text-align: center;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: 34px;
    letter-spacing: -0.02em;
  }
  .wordmark .dot {
    color: var(--lw-accent);
  }

  .login-sub {
    color: var(--muted);
    font-size: 13.5px;
    margin: 8px 0 30px;
  }

  .rule {
    height: 1px;
    background: var(--lw-line);
    width: 44px;
    margin: 0 auto 30px;
  }

  .field {
    text-align: left;
    margin-bottom: 14px;
  }
  .field label {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 7px;
    letter-spacing: 0.02em;
  }

  .input {
    width: 100%;
    padding: 12px 14px;
    background: var(--lw-surface);
    border: 1px solid var(--lw-line);
    border-radius: var(--radius);
    font: inherit;
    color: inherit;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .input:focus {
    outline: none;
    border-color: var(--lw-accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--lw-accent) 18%, transparent);
  }
  .input.pw {
    letter-spacing: 0.2em;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--lw-accent);
    color: var(--lw-accent-ink);
    font: inherit;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: transform 0.12s var(--ease), filter 0.2s var(--ease);
  }
  .btn:hover {
    filter: brightness(1.06);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn.block {
    width: 100%;
  }
  .btn[disabled] {
    opacity: 0.55;
    cursor: default;
  }

  .login-error {
    margin: 14px 0 0;
    font-size: 12.5px;
    color: var(--lw-danger);
  }
  .login-error[hidden] {
    display: none;
  }

  .login-foot {
    margin-top: 22px;
    font-size: 12px;
    color: var(--faint, var(--muted));
  }
</style>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const passwordInput = document.getElementById('pw') as HTMLInputElement;
  const signinBtn = document.getElementById('signin') as HTMLButtonElement;
  const errEl = document.getElementById('err') as HTMLParagraphElement;

  function showError(message: string) {
    errEl.textContent = message;
    errEl.hidden = false;
  }

  function hideError() {
    errEl.hidden = true;
    errEl.textContent = '';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const password = passwordInput.value;
    signinBtn.disabled = true;
    signinBtn.textContent = 'Signing in…';

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ password }),
      });

      if (res.ok) {
        location.href = '/admin';
        return;
      }

      if (res.status === 401) {
        showError("That password didn't match.");
      } else {
        let serverMessage: string | undefined;
        try {
          const body = await res.json();
          if (body && typeof body.error === 'string') serverMessage = body.error;
        } catch {
          // response body wasn't JSON (or parsing failed) — fall back below
        }
        showError(serverMessage ?? `Something went wrong on the server (HTTP ${res.status}). Try again.`);
      }
      signinBtn.disabled = false;
      signinBtn.textContent = 'Sign in';
    } catch {
      showError("Couldn't reach the server — try again.");
      signinBtn.disabled = false;
      signinBtn.textContent = 'Sign in';
    }
  });
</script>
