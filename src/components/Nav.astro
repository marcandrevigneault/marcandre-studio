---
import Text from './Text.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/photography/', label: 'Photographie', en: 'Photography', ready: false },
  { href: '/art/', label: 'Art', en: 'Art', ready: false },
  { href: '/projects/', label: 'Projets', en: 'Projects' },
  { href: '/science/', label: 'Science', en: 'Science', ready: false },
  { href: '/about/', label: 'À propos', en: 'About' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-nav">
  <nav class="wrap">
    <div class="brand-menu"><a href="/" class="brand" aria-label="mytinylab · Accueil" data-i18n-fr-aria-label="mytinylab · Accueil" data-i18n-en-aria-label="mytinylab · Home">mytinylab</a>
    <details class="menu-disclosure"><summary aria-label="Menu"><span class="hamburger" aria-hidden="true"><i></i><i></i><i></i></span></summary>
    <div class="menu-panel">
    <ul>
      {links.map((l) => (
        <li>
          {l.ready === false ? (
            <span class="coming-soon" aria-disabled="true">
              <Text fr={l.label} en={l.en} />
              <span class="status"><Text fr="À venir" en="Coming soon" /></span>
            </span>
          ) : (
            <a href={l.href} class:list={[{ active: isActive(l.href) }]}><Text fr={l.label} en={l.en} /></a>
          )}
        </li>
      ))}
    </ul>
    <a href="/admin" class="admin-link" hidden>Administration</a>
    </div></details></div>
    <div class="languages" role="group" aria-label="Langue" data-i18n-fr-aria-label="Langue" data-i18n-en-aria-label="Language">
      <button type="button" data-set-language="fr" aria-pressed="true" aria-label="Français">FR</button>
      <button type="button" data-set-language="en" aria-pressed="false" aria-label="English">EN</button>
    </div>
  </nav>
</header>
<a href="/admin" class="visitor-return" hidden>Vue visiteur · Retour à l’administration ↗</a>

<style>
  .languages { display: flex; gap: .2rem; }
  .languages button { min-width:40px;min-height:44px;cursor: pointer; background: transparent; color: var(--muted); border: 1px solid transparent; padding: .35rem .45rem; font: inherit; font-size: .75rem; }
  .languages button[aria-pressed="true"] { color: var(--ink); border-color: var(--line); }
  .languages button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(10px);
    background: color-mix(in oklab, var(--paper) 80%, transparent);
    border-bottom: 1px solid var(--line);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    position: relative;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(130px,1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a, .coming-soon {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .coming-soon { display: inline-block; color: var(--muted); opacity: .55; cursor: default; }
  .status { display: block; margin-top: .2rem; font-size: .6rem; letter-spacing: .06em; }
  ul a:hover { color: var(--ink); }
  ul a.active { color: var(--ink); }
  ul a.active::after {
    content: "";
    display: block;
    height: 1px;
    margin-top: 4px;
    background: var(--accent);
  }
</style>

<script>
  const menu=document.querySelector<HTMLDetailsElement>('.menu-disclosure');
  const summary=menu?.querySelector('summary');
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu?.open){menu.open=false;summary?.focus();}});
  document.addEventListener('click',event=>{if(menu?.open&&event.target instanceof Node&&!menu.contains(event.target))menu.open=false;});
  menu?.querySelectorAll('a').forEach(anchor=>anchor.addEventListener('click',()=>{menu.open=false;}));
  import { visitorView } from '../lib/visitor-view';
  const preview = visitorView();
  const back = document.querySelector<HTMLAnchorElement>('.visitor-return');
  const link = document.querySelector<HTMLAnchorElement>('.admin-link');
  fetch('/api/auth/session', {cache:'no-store'}).then(r=>r.json()).then(data=>{
    if(link) link.hidden=data.authenticated!==true || preview;
    if(back) {
      back.hidden=data.authenticated!==true;
      back.textContent=preview ? 'Retour à l’administration ↗' : 'Voir comme visiteur ↗';
      if(!preview) {
        const target=new URL(location.href);
        target.searchParams.delete('edit');
        target.searchParams.set('visitor','1');
        back.href=target.pathname+target.search+target.hash;
      }
    }
  }).catch(()=>{});
</script>
<style>
  .admin-link[hidden] { display: none; }
  .admin-link { font-size: .75rem; border: 1px solid var(--line); padding: .4rem .6rem; }
</style>

<style>
  .visitor-return[hidden] { display: none; }
  .visitor-return { position: fixed; bottom: 1rem; right: 1rem; z-index: 80; max-width: calc(100vw - 2rem); padding: .7rem 1rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); box-shadow: 0 2px 12px #0002; font: .75rem var(--font-sans); }
</style>

<style>
 .brand-menu { display:flex;align-items:center;gap:.7rem; }
 .menu-disclosure summary { display:flex;align-items:center;justify-content:center;list-style:none;cursor:pointer;width:44px;height:44px;border:1px solid transparent;border-radius:3px; }
 .menu-disclosure summary::-webkit-details-marker { display:none; }
 .menu-disclosure summary:hover,.menu-disclosure[open] summary { border-color:var(--line); }
 .menu-disclosure summary:focus-visible { outline:2px solid var(--accent);outline-offset:2px; }
 .hamburger { display:grid;gap:5px;width:20px; }
 .hamburger i { display:block;height:1px;background:var(--ink);transition:transform .15s,opacity .15s; }
 .menu-disclosure[open] i:first-child { transform:translateY(6px) rotate(45deg); }
 .menu-disclosure[open] i:nth-child(2) { opacity:0; }
 .menu-disclosure[open] i:last-child { transform:translateY(-6px) rotate(-45deg); }
 .menu-panel { position:absolute;top:100%;left:0;right:0;padding:1.5rem;background:var(--paper);border:1px solid var(--line);box-shadow:0 12px 24px #0001;max-height:70vh;overflow:auto; }
 .menu-panel .admin-link { display:inline-block;margin-top:1.5rem; }
 @media(prefers-reduced-motion:reduce) { .hamburger i { transition:none; } }
</style>

<style>
 .menu-panel .admin-link[hidden] { display:none; }
 .menu-panel ul a { display:block;min-height:44px;padding:.65rem 0; }
</style>
